/* Service card images: visible, consistent, and responsive */
.service-card { overflow: hidden; padding-top: 0; }
.service-image { display: block; width: calc(100% + 54px); max-width: none; height: 155px; object-fit: cover; margin: 0 -27px 22px; background: linear-gradient(135deg, #082b50, #078fda); }
.service-card.featured .service-image { filter: saturate(.9); }
@media (max-width: 700px) { .service-image { width: calc(100% + 42px); height: 135px; margin-left: -21px; margin-right: -21px; margin-bottom: 18px; } }
@media (max-width: 390px) { .service-image { height: 175px; } }

/* Fix square logo sizing in the navigation and footer */
.brand { width: 76px; height: 76px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.brand img { width: 100%; height: 100%; object-fit: contain; }
.footer-brand { width: 105px; height: 105px; display: block; flex-shrink: 0; }
.footer-brand img { width: 100%; height: 100%; object-fit: contain; }
@media (max-width: 700px) { .brand { width: 66px; height: 66px; } }
